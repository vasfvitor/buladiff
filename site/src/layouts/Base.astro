---
import Search from "astro-pagefind/components/Search.astro";
import { ANVISA_BULARIO, url } from "../lib/format";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "O que mudou em cada versão de bula publicada no Bulário Eletrônico da ANVISA." } =
  Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · buladiff</title>
    <meta name="description" content={description} />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="sitemap" href={url("/sitemap-index.xml")} />
    <script is:inline>
      // aplica o tema salvo antes da primeira pintura, para não piscar (por isso inline)
      try {
        const t = localStorage.getItem("theme");
        if (t === "dark" || t === "light") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#conteudo">Ir para o conteúdo</a>
    <header class="site">
      <div class="inner">
        <a class="brand" href={url("/")}>buladiff</a>
        <nav>
          <a href={url("/produtos/")}>Produtos</a>
          <a href={url("/sobre/")}>Sobre</a>
        </nav>
        <button class="theme-toggle" type="button" id="theme-toggle" aria-label="Alternar tema claro/escuro" title="Tema claro/escuro"></button>
        <div class="search">
          <Search
            id="search"
            className="pagefind-ui"
            uiOptions={{ showImages: false, translations: { placeholder: "Buscar medicamento ou empresa", zero_results: "Nada encontrado para [SEARCH_TERM]" } }}
          />
        </div>
      </div>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    <footer class="site">
      Dados do <a href={ANVISA_BULARIO}>Bulário Eletrônico da ANVISA</a>, extraídos automaticamente.
      Ferramenta independente, sem vínculo com a ANVISA. Confira sempre a bula oficial.
    </footer>
    <script>
      // empacotado pelo Astro e compartilhado entre as páginas
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const root = document.documentElement;
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const current = root.dataset.theme || (systemDark ? "dark" : "light");
        const next = current === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          // se o escolhido coincide com o do sistema, volta a seguir o sistema
          if ((next === "dark") === systemDark) {
            localStorage.removeItem("theme");
            delete root.dataset.theme;
          } else localStorage.setItem("theme", next);
        } catch {}
      });
    </script>
  </body>
</html>
