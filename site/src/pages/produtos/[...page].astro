---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import FiltroTabela from "../../components/FiltroTabela.astro";
import { produtos } from "../../lib/data";
import { dataBR, produtoUrl, formatCnpj } from "../../lib/format";

export const getStaticPaths = (({ paginate }) => paginate(produtos, { pageSize: 100 })) satisfies GetStaticPaths;
const { page } = Astro.props;
---

<Base title="Produtos">
  <h1>Produtos acompanhados <span class="sub">{page.total}</span></h1>
  <FiltroTabela tabela="tabela-produtos" placeholder="Filtrar por nome, empresa ou princípio ativo" />
  <div class="table-wrap">
    <table id="tabela-produtos">
      <thead>
        <tr><th>Produto</th><th class="hide-narrow">Princípio ativo</th><th>Empresa</th><th class="num hide-narrow">Versões</th><th class="num">Última bula</th></tr>
      </thead>
      <tbody>
        {page.data.map((p) => (
          <tr data-texto={`${p.nome} ${p.empresa} ${p.principio_ativo} ${p.classes.join(" ")} ${p.categoria}`.toLowerCase()}>
            <td><a href={produtoUrl(p.registro)}>{p.nome}</a> {p.categoria && <span class="sub hide-narrow">{p.categoria.toLowerCase()}</span>}</td>
            <td class="hide-narrow">{p.principio_ativo.toLowerCase()}</td>
            <td>{p.empresa} <span class="sub hide-narrow">{formatCnpj(p.cnpj)}</span></td>
            <td class="num hide-narrow">{p.n_versoes}</td>
            <td class="num">{dataBR(p.ultima_publicacao)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {(page.url.prev || page.url.next) && (
    <nav class="pagination">
      {page.url.prev && <a href={page.url.prev}>← Anteriores</a>}
      <span class="muted">página {page.currentPage} de {page.lastPage}</span>
      {page.url.next && <a href={page.url.next}>Próximos →</a>}
    </nav>
  )}
</Base>
