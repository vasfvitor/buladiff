---
import Base from "../layouts/Base.astro";
import Secoes from "../components/Secoes.astro";
import LegendaDeclarada from "../components/LegendaDeclarada.astro";
import { produtos, recentes, feed, catalogo } from "../lib/data";
import { dataBR, produtoUrl, diffUrl, catalogoUrl, TIPO_NOME } from "../lib/format";

const publicacoes = [...feed.publicacoes].sort((a, b) => b.data.localeCompare(a.data)).slice(0, 12);
---

<Base title="Início">
  <h1>O que mudou nas bulas</h1>
  <p class="lead">
    A ANVISA publica cada nova versão de bula como PDF. Este site arquiva o texto de cada versão e mostra,
    seção por seção, o que mudou de uma para a outra. <a href={produtoUrl("")}>{produtos.length} produtos acompanhados</a>{catalogo.produtos.length > 0 && <span>, de <a href={catalogoUrl()}>{catalogo.produtos.length.toLocaleString("pt-BR")} no Bulário</a></span>}.
  </p>

  <h2>Últimas alterações</h2>
  <p class="note">Números = seções da bula alteradas; <LegendaDeclarada /></p>
  <ol class="changes">
    {recentes.slice(0, 12).map((r) => (
      <li>
        <div class="when">{dataBR(r.para_data)}</div>
        <div class="what">
          <a class="name" href={produtoUrl(r.registro)}>{r.nome}</a>
          <span class="sub">{r.empresa}</span>
        </div>
        <div class="which"><a href={diffUrl(r.registro, r.slug)}>{TIPO_NOME[r.tipo]}</a></div>
        <div class="chips"><Secoes tipo={r.tipo} secoes={r.alteradas} declaradas={r.declarado} href={diffUrl(r.registro, r.slug)} /></div>
      </li>
    ))}
  </ol>

  {publicacoes.length > 0 && (
    <>
      <h2>Publicadas no Bulário recentemente</h2>
      <p class="note">Tudo que entrou no Bulário{feed.ate ? ` até ${dataBR(feed.ate)}` : ""}; sem link = ainda não arquivado aqui.</p>
      <ol class="changes compact">
        {publicacoes.map((p) => (
          <li>
            <div class="when">{dataBR(p.data)}</div>
            <div class="what">
              {p.arquivado ? <a class="name" href={produtoUrl(p.registro)}>{p.nome}</a> : <span class="name">{p.nome}</span>}
              <span class="sub">{p.empresa}</span>
            </div>
            <div class="which sub hide-narrow">expediente {p.expediente}</div>
          </li>
        ))}
      </ol>
    </>
  )}
</Base>
