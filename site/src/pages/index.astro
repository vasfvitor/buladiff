---
import Base from "../layouts/Base.astro";
import Secoes from "../components/Secoes.astro";
import LegendaDeclarada from "../components/LegendaDeclarada.astro";
import { produtos, recentes, feed } from "../lib/data";
import { dataBR, produtoUrl, diffUrl, TIPO_NOME } from "../lib/format";

const publicacoes = [...feed.publicacoes].sort((a, b) => b.data.localeCompare(a.data)).slice(0, 20);
---

<Base title="Início">
  <h1>O que mudou nas bulas</h1>
  <p class="lead">
    A ANVISA publica cada nova versão de bula como PDF. Este site arquiva o texto de cada versão e mostra,
    seção por seção, o que mudou de uma para a outra. {produtos.length} produtos acompanhados.
  </p>

  <h2>Últimas alterações</h2>
  <p class="note">Cada número é uma seção da bula; clique para ir direto à mudança. <LegendaDeclarada /></p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Publicada em</th><th>Produto</th><th>Bula</th><th>Seções alteradas</th></tr>
      </thead>
      <tbody>
        {recentes.slice(0, 12).map((r) => (
          <tr>
            <td class="num">{dataBR(r.para_data)}</td>
            <td>
              <a href={produtoUrl(r.registro)}>{r.nome}</a>
              <div class="sub">{r.empresa}</div>
            </td>
            <td><a href={diffUrl(r.registro, r.slug)}>{TIPO_NOME[r.tipo]}</a></td>
            <td><Secoes tipo={r.tipo} secoes={r.alteradas} declaradas={r.declarado} href={diffUrl(r.registro, r.slug)} /></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {publicacoes.length > 0 && (
    <>
      <h2>Publicadas no Bulário recentemente</h2>
      <p class="note">
        Tudo que entrou no Bulário Eletrônico{feed.ate ? ` até ${dataBR(feed.ate)}` : ""}. Produtos com
        link já estão arquivados aqui.
      </p>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Data</th><th>Produto</th><th>Empresa</th><th>Expediente</th></tr></thead>
          <tbody>
            {publicacoes.map((p) => (
              <tr>
                <td class="num">{dataBR(p.data)}</td>
                <td>{p.arquivado ? <a href={produtoUrl(p.registro)}>{p.nome}</a> : p.nome}</td>
                <td>{p.empresa}</td>
                <td class="num">{p.expediente}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}
</Base>
