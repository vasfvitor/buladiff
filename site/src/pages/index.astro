---
import Base from "../layouts/Base.astro";
import Secoes from "../components/Secoes.astro";
import { produtos, feed, todosDetalhes, dataBR, url, diffSlug, TIPO_NOME } from "../lib/data";

const recentes = todosDetalhes()
  .flatMap((d) => d.diffs.map((diff) => ({ produto: d.meta, diff })))
  .sort((a, b) => b.diff.para_data.localeCompare(a.diff.para_data))
  .slice(0, 12);
const publicacoes = [...feed.publicacoes].sort((a, b) => b.data.localeCompare(a.data)).slice(0, 20);
const monitorados = new Set(produtos.map((p) => p.registro));
---

<Base title="Início">
  <h1>O que mudou nas bulas</h1>
  <p class="lead">
    A ANVISA publica cada nova versão de bula como PDF. Este site arquiva o texto de cada versão e mostra,
    seção por seção, o que mudou de uma para a outra. {produtos.length} produtos acompanhados.
  </p>

  <h2>Últimas alterações</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Publicada em</th><th>Produto</th><th>Bula</th><th>Seções alteradas</th></tr>
      </thead>
      <tbody>
        {recentes.map(({ produto, diff }) => (
          <tr>
            <td class="num">{dataBR(diff.para_data)}</td>
            <td>
              <a href={url(`/produto/${produto.registro}/`)}>{produto.nome}</a>
              <div class="muted" style="font-size:.85rem">{produto.empresa}</div>
            </td>
            <td><a href={url(`/produto/${produto.registro}/${diffSlug(diff)}/`)}>{TIPO_NOME[diff.tipo]}</a></td>
            <td><Secoes tipo={diff.tipo} secoes={diff.alteradas} declaradas={diff.declarado} /></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {publicacoes.length > 0 && (
    <>
      <h2>Publicadas no Bulário recentemente</h2>
      <p class="note">
        Tudo que entrou no Bulário Eletrônico{feed.ate ? ` até ${dataBR(feed.ate)}` : ""}. Produtos com
        link já estão arquivados aqui.
      </p>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Data</th><th>Produto</th><th>Empresa</th><th>Expediente</th></tr></thead>
          <tbody>
            {publicacoes.map((p) => (
              <tr>
                <td class="num">{dataBR(p.data)}</td>
                <td>{monitorados.has(p.registro) ? <a href={url(`/produto/${p.registro}/`)}>{p.nome}</a> : p.nome}</td>
                <td>{p.empresa}</td>
                <td class="num">{p.expediente}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}
</Base>
