---
import Base from "../../../layouts/Base.astro";
import Secoes from "../../../components/Secoes.astro";
import LegendaDeclarada from "../../../components/LegendaDeclarada.astro";
import { produtos, detalhe, type Diff } from "../../../lib/data";
import { dataBR, diffUrl, anvisaUrl, formatCnpj, TIPO_NOME, TIPO_CURTO } from "../../../lib/format";

export function getStaticPaths() {
  return produtos.map((p) => ({ params: { registro: p.registro } }));
}
const { meta, versoes, diffs } = await detalhe(Astro.params.registro!);
// diffs que chegam em cada versão (a versão "para"), na ordem paciente → profissional
const chegando = new Map<string, Diff[]>();
for (const d of diffs) chegando.set(d.para, [...(chegando.get(d.para) ?? []), d]);
const ordemTipo = (d: Diff) => (d.tipo === "vp" ? 0 : 1);
const SITUACAO_PADRAO = "Aditado ao processo"; // é a situação de quase toda versão; só vale mostrar as outras
---

<Base title={meta.nome} description={`Histórico de versões e alterações da bula de ${meta.nome} (${meta.empresa}).`}>
  <article data-pagefind-body>
    <h1>{meta.nome}</h1>
    <p class="muted" data-pagefind-meta="empresa">
      {meta.empresa} · CNPJ {formatCnpj(meta.cnpj)} · registro {meta.registro}
      · <a href={anvisaUrl(meta.idProduto)} rel="noopener">ver no Bulário da ANVISA</a>
    </p>
    {meta.principio_ativo && (
      <p class="muted" data-pagefind-meta="principio_ativo">
        {meta.principio_ativo.toLowerCase()}
        {meta.categoria && <span> · {meta.categoria.toLowerCase()}</span>}
        {meta.referencia && meta.referencia.toUpperCase() !== meta.nome.toUpperCase() && (
          <span> · referência: {meta.referencia}</span>
        )}
        {meta.classes.length > 0 && <span> · {meta.classes.map((c) => c.toLowerCase()).join(", ")}</span>}
      </p>
    )}
    {meta.apresentacoes.length > 0 && (
      <details class="apresentacoes">
        <summary class="sub">{meta.apresentacoes.length} {meta.apresentacoes.length === 1 ? "apresentação registrada" : "apresentações registradas"}</summary>
        <ul class="sub">{meta.apresentacoes.map((a) => <li>{a}</li>)}</ul>
      </details>
    )}

    <h2>Versões</h2>
    <p class="note">Seções alteradas em relação à versão anterior; <LegendaDeclarada /></p>
    <ol class="timeline">
      {[...versoes].reverse().map((v) => {
        const lista = [...(chegando.get(v.expediente) ?? [])].sort((a, b) => ordemTipo(a) - ordemTipo(b));
        return (
          <li>
            <div class="when">{dataBR(v.data)}</div>
            <div>
              <div class="sub">
                expediente {v.expediente}
                {v.situacao && v.situacao !== SITUACAO_PADRAO && <span> · {v.situacao}</span>}
                {v.republicada.length > 0 && <span> · relistada em {v.republicada.map(dataBR).join(", ")}</span>}
              </div>
              {lista.length === 0 ? (
                <div class="muted">{v.repetida ? "mesmos PDFs da versão anterior" : "primeira versão arquivada"}</div>
              ) : (
                <div class="bulas">
                  {lista.map((x) => (
                    <div class="bula-row">
                      <a class="bula-tipo" href={diffUrl(meta.registro, x.slug)} title={TIPO_NOME[x.tipo]}>{TIPO_CURTO[x.tipo]}</a>
                      <Secoes tipo={x.tipo} secoes={x.alteradas} declaradas={x.declarado} href={diffUrl(meta.registro, x.slug)} />
                    </div>
                  ))}
                </div>
              )}
            </div>
          </li>
        );
      })}
    </ol>
  </article>
</Base>
