---
import Base from "../../../layouts/Base.astro";
import Secoes from "../../../components/Secoes.astro";
import LegendaDeclarada from "../../../components/LegendaDeclarada.astro";
import { produtos, detalhe, type Diff } from "../../../lib/data";
import { dataBR, diffUrl, anvisaUrl, formatCnpj, TIPO_NOME } from "../../../lib/format";

export function getStaticPaths() {
  return produtos.map((p) => ({ params: { registro: p.registro } }));
}
const { meta, versoes, diffs } = await detalhe(Astro.params.registro!);
// diffs que chegam em cada versão (a versão "para")
const chegando = new Map<string, Diff[]>();
for (const d of diffs) chegando.set(d.para, [...(chegando.get(d.para) ?? []), d]);
---

<Base title={meta.nome} description={`Histórico de versões e alterações da bula de ${meta.nome} (${meta.empresa}).`}>
  <article data-pagefind-body>
    <h1>{meta.nome}</h1>
    <p class="muted" data-pagefind-meta="empresa">
      {meta.empresa} · CNPJ {formatCnpj(meta.cnpj)} · registro {meta.registro}
      · <a href={anvisaUrl(meta.idProduto)} rel="noopener">ver no Bulário da ANVISA</a>
    </p>

    <h2>Versões</h2>
    <p class="note">
      Da mais recente para a mais antiga. Em cada versão, as seções alteradas em relação à anterior — clique
      no número para ir à mudança. <LegendaDeclarada />
    </p>
    <ol class="timeline">
      {[...versoes].reverse().map((v) => (
        <li>
          <div class="when">{dataBR(v.data)}</div>
          <div>
            <div>
              expediente <strong>{v.expediente}</strong>
              {v.situacao && <span class="muted"> · {v.situacao}</span>}
              {v.republicada.length > 0 && (
                <span class="muted"> · relistada em {v.republicada.map(dataBR).join(", ")}</span>
              )}
            </div>
            {(chegando.get(v.expediente) ?? []).length === 0 ? (
              <div class="sub">primeira versão arquivada</div>
            ) : (
              <div class="links">
                {chegando.get(v.expediente)!.map((x) => (
                  <span>
                    <a href={diffUrl(meta.registro, x.slug)}>{TIPO_NOME[x.tipo]}</a>:
                    <Secoes tipo={x.tipo} secoes={x.alteradas} declaradas={x.declarado} href={diffUrl(meta.registro, x.slug)} />
                  </span>
                ))}
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </article>
</Base>
