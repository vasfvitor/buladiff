---
import Base from "../../../layouts/Base.astro";
import Secoes from "../../../components/Secoes.astro";
import LegendaDeclarada from "../../../components/LegendaDeclarada.astro";
import TituloApresentacao from "../../../components/TituloApresentacao.astro";
import { produtos, detalhe } from "../../../lib/data";
import { dataBR, produtoUrl, nomeSecao, anvisaUrl, TIPO_NOME } from "../../../lib/format";

export function getStaticPaths() {
  return produtos.flatMap((p) => p.diffs.map((slug) => ({ params: { registro: p.registro, diff: slug } })));
}
const { meta, diffs } = await detalhe(Astro.params.registro!);
const diff = diffs.find((d) => d.slug === Astro.params.diff)!;
const multi = diff.documentos.length > 1;
const docs = diff.documentos.map((doc) => ({ ...doc, alteradas: doc.secoes.filter((s) => s.alterada) }));
const totalAlteradas = docs.reduce((n, d) => n + d.alteradas.length, 0);
---

<Base
  title={`${meta.nome} — ${TIPO_NOME[diff.tipo]} ${dataBR(diff.de_data)} → ${dataBR(diff.para_data)}`}
  description={`Diferenças na ${TIPO_NOME[diff.tipo].toLowerCase()} de ${meta.nome} entre ${dataBR(diff.de_data)} e ${dataBR(diff.para_data)}.`}
>
  <p class="muted"><a href={produtoUrl(meta.registro)}>{meta.nome}</a> · {meta.empresa}</p>
  <h1>{TIPO_NOME[diff.tipo]}: {dataBR(diff.de_data)} → {dataBR(diff.para_data)}</h1>
  <p class="muted">
    expediente {diff.de} → {diff.para} ·
    <a href={anvisaUrl(meta.idProduto)} rel="noopener">PDFs no Bulário da ANVISA</a>
  </p>

  <div class="card">
    <div><strong>Seções alteradas:</strong> <Secoes tipo={diff.tipo} secoes={diff.alteradas} declaradas={diff.declarado} href="" /></div>
    <p class="note">
      <LegendaDeclarada />{diff.declarado.length === 0 && " — este PDF não traz a tabela de histórico"}
      {multi && `. ${docs.length} apresentações no mesmo PDF, comparadas uma a uma`}.
    </p>
  </div>

  <h2>Alterações</h2>
  <p class="legend">
    <span><del>removido</del></span><span><ins>adicionado</ins></span>
    <button type="button" class="modo-diff" id="modo-diff" aria-pressed="false" title="Versão antiga à esquerda, nova à direita">lado a lado</button>
  </p>
  {totalAlteradas === 0 && <p class="muted">O texto extraído das duas versões é idêntico.</p>}
  <div class="diff">
    {docs.map((doc) => (
      <>
        {multi && <TituloApresentacao doc={doc} />}
        {doc.alteradas.map((s) => (
          <section>
            <h3 id={s.ancora}>
              {multi && <span class="sub">Apresentação {doc.indice} · </span>}
              {nomeSecao(diff.tipo, s.secao)}
              {s.declarada && <span class="badge declared" title="declarada pela empresa">{s.secao}</span>}
              <span class="sub"> {s.palavras} palavras</span>
            </h3>
            {s.contexto ? (
              <div class="trecho">
                <div class="texto contexto" set:html={s.contexto} />
                <details>
                  <summary class="sub">ver a seção completa</summary>
                  <div class="texto" set:html={s.html} />
                </details>
              </div>
            ) : (
              <div class="texto" set:html={s.html} />
            )}
          </section>
        ))}
        {multi && doc.alteradas.length === 0 && <p class="muted">Sem alterações nesta apresentação.</p>}
      </>
    ))}
  </div>

  <h2>Todas as seções</h2>
  {docs.map((doc) => (
    <>
      {multi && <TituloApresentacao doc={doc} />}
      <div class="table-wrap">
        <table class="resumo">
          <thead><tr><th>Seção</th><th class="num">Palavras alteradas</th><th class="num hide-narrow">Semelhança</th></tr></thead>
          <tbody>
            {doc.secoes.map((s) => (
              <tr class={s.alterada ? "" : "row-igual"}>
                <td>{s.alterada ? <a href={`#${s.ancora}`}>{nomeSecao(diff.tipo, s.secao)}</a> : nomeSecao(diff.tipo, s.secao)}</td>
                <td class="num">{s.palavras || ""}</td>
                <td class="num hide-narrow">{Math.round(s.ratio * 100)}%</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  ))}
  <p class="note">
    {diff.marcado
      ? "Texto extraído da estrutura do PDF (parágrafos e células de tabela); ainda assim, na dúvida, o PDF no Bulário é a fonte."
      : "PDF sem marcação de estrutura: o texto foi extraído linha a linha, sem parágrafos, e quebras de página ou tabelas podem gerar diferenças que não existem na bula. Na dúvida, o PDF no Bulário é a fonte."}
  </p>
</Base>

<script>
  // Lado a lado: derivado do mesmo HTML do diff. À esquerda o texto sem <ins> (versão antiga), à direita
  // sem <del> (versão nova), uma linha da grade por parágrafo. Em telas estreitas fica sempre unificado.
  const KEY = "diff-modo";
  const btn = document.getElementById("modo-diff") as HTMLButtonElement | null;
  const textos = Array.from(document.querySelectorAll<HTMLElement>(".diff .texto"));
  const original = new Map(textos.map((el) => [el, el.innerHTML]));
  const estreito = matchMedia("(max-width: 48rem)");

  function ladoALado(html: string): DocumentFragment {
    const fonte = document.createElement("div");
    fonte.innerHTML = html;
    const paragrafos: Node[][] = [[]];
    for (const n of Array.from(fonte.childNodes)) {
      if (n instanceof HTMLElement && n.classList.contains("pbr")) paragrafos.push([]);
      else paragrafos[paragrafos.length - 1].push(n);
    }
    const grade = document.createElement("div");
    grade.className = "split";
    for (const nos of paragrafos) {
      for (const lado of ["old", "new"] as const) {
        const celula = document.createElement("div");
        celula.className = lado;
        for (const n of nos) celula.appendChild(n.cloneNode(true));
        celula.querySelectorAll(lado === "old" ? "ins" : "del").forEach((e) => e.remove());
        if (!celula.textContent?.trim()) celula.classList.add("vazio");
        grade.appendChild(celula);
      }
    }
    const frag = document.createDocumentFragment();
    frag.appendChild(grade);
    return frag;
  }

  function aplicar(modo: "unificado" | "lado") {
    const lado = modo === "lado" && !estreito.matches;
    for (const el of textos) {
      const html = original.get(el) ?? "";
      el.replaceChildren(lado ? ladoALado(html) : document.createRange().createContextualFragment(html));
      el.classList.toggle("lado", lado);
    }
    if (btn) {
      btn.setAttribute("aria-pressed", String(modo === "lado"));
      btn.textContent = modo === "lado" ? "unificado" : "lado a lado";
    }
  }

  let modo: "unificado" | "lado" = "unificado";
  const daUrl = new URLSearchParams(location.search).get("modo");
  try {
    if (daUrl === "lado" || (!daUrl && localStorage.getItem(KEY) === "lado")) modo = "lado";
  } catch {
    /* sem localStorage: fica unificado */
  }
  if (modo === "lado") aplicar(modo);
  btn?.addEventListener("click", () => {
    modo = modo === "lado" ? "unificado" : "lado";
    aplicar(modo);
    try {
      localStorage.setItem(KEY, modo);
    } catch {
      /* ignora */
    }
  });
  estreito.addEventListener("change", () => aplicar(modo));
</script>
