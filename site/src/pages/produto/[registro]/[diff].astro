---
import Base from "../../../layouts/Base.astro";
import Secoes from "../../../components/Secoes.astro";
import LegendaDeclarada from "../../../components/LegendaDeclarada.astro";
import TituloApresentacao from "../../../components/TituloApresentacao.astro";
import { produtos, detalhe } from "../../../lib/data";
import { dataBR, produtoUrl, nomeSecao, anvisaUrl, TIPO_NOME } from "../../../lib/format";

export function getStaticPaths() {
  return produtos.flatMap((p) => p.diffs.map((slug) => ({ params: { registro: p.registro, diff: slug } })));
}
const { meta, diffs } = await detalhe(Astro.params.registro!);
const diff = diffs.find((d) => d.slug === Astro.params.diff)!;
const multi = diff.documentos.length > 1;
const docs = diff.documentos.map((doc) => ({ ...doc, alteradas: doc.secoes.filter((s) => s.alterada) }));
---

<Base
  title={`${meta.nome} — ${TIPO_NOME[diff.tipo]} ${dataBR(diff.de_data)} → ${dataBR(diff.para_data)}`}
  description={`Diferenças na ${TIPO_NOME[diff.tipo].toLowerCase()} de ${meta.nome} entre ${dataBR(diff.de_data)} e ${dataBR(diff.para_data)}.`}
>
  <p class="muted"><a href={produtoUrl(meta.registro)}>{meta.nome}</a> · {meta.empresa}</p>
  <h1>{TIPO_NOME[diff.tipo]}: {dataBR(diff.de_data)} → {dataBR(diff.para_data)}</h1>
  <p class="muted">
    expediente {diff.de} → {diff.para} ·
    <a href={anvisaUrl(meta.idProduto)} rel="noopener">PDFs no Bulário da ANVISA</a>
  </p>

  <div class="card">
    <div><strong>Seções alteradas:</strong> <Secoes tipo={diff.tipo} secoes={diff.alteradas} declaradas={diff.declarado} href="" /></div>
    <div>
      <strong>Declaradas pela empresa:</strong>{" "}
      {diff.declarado.length ? <Secoes tipo={diff.tipo} secoes={diff.declarado} declaradas={diff.declarado} /> : <span class="muted">tabela de histórico ausente ou sem itens</span>}
    </div>
    {multi && <p class="note">Este PDF traz {docs.length} bulas (uma por apresentação); cada uma é comparada com a correspondente na versão anterior.</p>}
  </div>

  <h2>Resumo</h2>
  {docs.map((doc) => (
    <>
      {multi && <TituloApresentacao doc={doc} />}
      <div class="table-wrap">
        <table>
          <thead><tr><th>Seção</th><th>Status</th><th>Palavras alteradas</th><th>Semelhança</th></tr></thead>
          <tbody>
            {doc.secoes.map((s) => (
              <tr>
                <td>{s.alterada ? <a href={`#${s.ancora}`}>{nomeSecao(diff.tipo, s.secao)}</a> : nomeSecao(diff.tipo, s.secao)}</td>
                <td class={s.alterada ? "status-alterada" : "status-igual"}>{s.alterada ? "alterada" : "igual"}</td>
                <td class="num">{s.palavras || ""}</td>
                <td class="num">{Math.round(s.ratio * 100)}%</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  ))}

  <h2>Alterações</h2>
  <p class="legend"><span><del>removido</del></span><span><ins>adicionado</ins></span><LegendaDeclarada /></p>
  <div class="diff">
    {docs.map((doc) => (
      <>
        {multi && <TituloApresentacao doc={doc} />}
        {doc.alteradas.map((s) => (
          <section>
            <h3 id={s.ancora}>
              {multi && <span class="sub">Apresentação {doc.indice} · </span>}
              {nomeSecao(diff.tipo, s.secao)}
              {s.declarada && <span class="badge declared" title="declarada pela empresa">{s.secao}</span>}
              <span class="sub"> {s.palavras} palavras · semelhança {Math.round(s.ratio * 100)}%</span>
            </h3>
            <p set:html={s.html} />
          </section>
        ))}
        {doc.alteradas.length === 0 && <p class="muted">Sem alterações nesta apresentação.</p>}
      </>
    ))}
  </div>
  <p class="note">
    O texto vem do PDF oficial via extração automática; tabelas e quebras de página podem gerar diferenças
    que não existem na bula impressa. Em caso de dúvida, consulte o PDF no Bulário.
  </p>
</Base>
