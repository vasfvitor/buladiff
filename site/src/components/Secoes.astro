---
// Chips de seção, na ordem em que o exportador entrega. As declaradas pela empresa levam ✓ (âmbar).
// Com `href`, cada chip vira link para a âncora da seção: `href` é a página do diff, ou "" para a
// própria página.
import { nomeSecao, secaoId } from "../lib/format";

interface Props {
  tipo: string;
  secoes: string[];
  declaradas?: string[];
  href?: string;
}
const { tipo, secoes, declaradas = [], href } = Astro.props;
const declaradasSet = new Set(declaradas);
const Tag = href === undefined ? "span" : "a";
const chips = secoes.map((s) => {
  const declarada = declaradasSet.has(s);
  return {
    s,
    declarada,
    title: nomeSecao(tipo, s) + (declarada ? " — declarada pela empresa" : ""),
    href: href === undefined ? undefined : `${href}#${secaoId(tipo, s)}`,
  };
});
---

{chips.length === 0 ? (
  <span class="muted">sem alterações</span>
) : (
  <span class="badges">
    {chips.map((c) => (
      <Tag class:list={["badge", { declared: c.declarada }]} href={c.href} title={c.title}>{c.s}</Tag>
    ))}
  </span>
)}
